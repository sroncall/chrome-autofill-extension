{
  "name": "chrome-autofill-extension",
  "private": true,
  "version": "1.0.0",
  "description": "Chrome extension para autocompletar formularios y OTP con Mailinator",
  "scripts": {
    "build": "esbuild src/content.ts src/background.ts --bundle --format=iife --platform=browser --target=chrome114 --outdir=dist",
    "watch": "esbuild src/content.ts src/background.ts --bundle --format=iife --platform=browser --target=chrome114 --outdir=dist --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "powershell -ExecutionPolicy Bypass -File ./scripts/packageExtension.ps1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.29",
    "@faker-js/faker": "^9.0.3",
    "esbuild": "^0.23.1",
    "typescript": "^5.6.2"
  }
}
